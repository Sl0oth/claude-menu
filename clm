#!/usr/bin/env python3

import curses
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import textwrap
import threading
import time
import uuid
from dataclasses import dataclass
from datetime import datetime
from functools import lru_cache
from pathlib import Path


WORDMARK = (
    (" ╭──────╮", "╭─╮",      "╭─╮    ╭─╮"),
    ("╭╯ ╭────╯", "│ │",      "│  ╲  ╱  │"),
    ("│  │",      "│ │",      "│ │╲╲╱╱│ │"),
    ("╰╮ ╰────╮", "│ ╰────╮", "│ │ ╲╱ │ │"),
    (" ╰──────╯", "╰──────╯", "╰─╯    ╰─╯"),
)


@dataclass(frozen=True)
class Chat:
    session_id: str
    title: str
    preview: str
    modified: float


def plain(value):
    if not isinstance(value, str):
        return ""
    return " ".join("".join(c for c in value if c.isprintable() or c.isspace()).split())


def records(lines):
    for line in lines:
        try:
            entry = json.loads(line)
        except (ValueError, UnicodeError):
            continue
        if isinstance(entry, dict):
            yield entry


def read_chat(path):
    try:
        session_id = str(uuid.UUID(path.stem))
        stat = path.stat()
        with path.open("rb") as transcript:
            head = transcript.read(256 * 1024).split(b"\n")[:-1]
            tail_start = max(0, stat.st_size - 128 * 1024)
            transcript.seek(tail_start)
            if tail_start:
                transcript.readline()
            tail = transcript.read(128 * 1024).splitlines()
    except (ValueError, OSError):
        return None

    cwd = preview = title = ""
    for entry in records(head):
        if entry.get("type") != "user" or entry.get("sessionId") != session_id:
            continue
        if entry.get("isMeta") or entry.get("isSidechain"):
            continue
        message = entry.get("message")
        content = message.get("content") if isinstance(message, dict) else None
        if isinstance(content, list):
            content = " ".join(
                plain(block.get("text")) for block in content
                if isinstance(block, dict) and block.get("type") == "text"
            )
        current_dir = entry.get("cwd")
        if isinstance(current_dir, str) and Path(current_dir).is_absolute():
            cwd = cwd or current_dir
        candidate = plain(content)
        if candidate and not candidate.startswith("<"):
            candidate = plain(re.sub(r"</?pasted_content[^>]*>", " ", candidate))
            preview = candidate
            if cwd:
                break
    if not cwd:
        return None
    for entry in records(head + tail):
        if entry.get("type") == "custom-title" and entry.get("sessionId") == session_id:
            title = plain(entry.get("customTitle")) or title
    try:
        folder = Path(cwd).resolve()
        if not folder.is_dir():
            return None
    except (OSError, RuntimeError, ValueError):
        return None
    return folder, Chat(session_id, title or preview or "Untitled chat", preview, stat.st_mtime)


def catalog(root):
    config = Path(os.environ.get("CLAUDE_CONFIG_DIR", str(Path.home() / ".claude"))).expanduser()
    projects = {root: {}}
    utility_folders = {".gradle", ".git", "gradle", "manifest", "manifests",
                       "build", "node_modules", "__pycache__"}
    try:
        for folder in root.iterdir():
            if not folder.name.startswith(".") and folder.name.casefold() not in utility_folders and folder.is_dir():
                projects[folder.resolve()] = {}
    except OSError:
        pass
    for transcript in (config / "projects").glob("*/*.jsonl"):
        result = read_chat(transcript)
        if result is None:
            continue
        folder, chat = result
        if folder != root and root not in folder.parents:
            continue
        chats = projects.setdefault(folder, {})
        previous = chats.get(chat.session_id)
        if previous is None or previous.modified < chat.modified:
            chats[chat.session_id] = chat
    ordered = [
        (folder, sorted(chats.values(), key=lambda chat: -chat.modified))
        for folder, chats in projects.items()
    ]
    return sorted(ordered, key=lambda item: (
        -item[1][0].modified if item[1] else 0,
        item[0].name.casefold(),
        str(item[0]),
    ))


def shorten(path):
    try:
        return "~/" + str(path.relative_to(Path.home()))
    except ValueError:
        return str(path)


def clipped(value, limit):
    return value if len(value) <= limit else value[:max(0, limit - 1)] + "…"


AGES = ((31536000, "y", "year"), (2592000, "mo", "month"), (604800, "w", "week"),
        (86400, "d", "day"), (3600, "h", "hour"), (60, "m", "minute"))


def ago(stamp, long=False):
    seconds = max(0, time.time() - stamp)
    for size, short, word in AGES:
        if seconds >= size:
            count = int(seconds // size)
            return f"{count} {word}{'s' * (count != 1)} ago" if long else f"{count}{short}"
    return "just now" if long else "now"


def heat(stamp):
    if stamp is None:
        return "dim"
    age = time.time() - stamp
    return "new" if age < 86400 else "old" if age < 604800 else "dim"


@lru_cache(maxsize=None)
def git_branch(folder):
    try:
        head = (folder / ".git" / "HEAD").read_text().strip()
    except (OSError, UnicodeError):
        return ""
    return head.removeprefix("ref: refs/heads/") if head.startswith("ref:") else head[:7]


UPDATE_URL = "https://raw.githubusercontent.com/Sl0oth/claude-menu/main/clm"
HERE = Path(__file__).resolve()
CACHE = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "clm" / "update.json"


def from_git():
    return (HERE.parent / ".git").exists()


def fetch_latest():
    try:
        result = subprocess.run(["curl", "-fsSL", "--max-time", "8", UPDATE_URL],
                                capture_output=True, check=False)
    except OSError:
        return None
    body = result.stdout
    if result.returncode or not body.startswith(b"#!") or b"python3" not in body.split(b"\n", 1)[0]:
        return None
    return body


def remember(remote):
    try:
        CACHE.parent.mkdir(parents=True, exist_ok=True)
        CACHE.write_text(json.dumps({"checked": time.time(), "remote": remote}))
    except OSError:
        pass


def watch_for_update(state):
    if os.environ.get("CLM_NO_UPDATE_CHECK") or from_git():
        return
    try:
        local = hashlib.sha256(HERE.read_bytes()).hexdigest()
        cache = json.loads(CACHE.read_text())
    except (OSError, ValueError):
        cache = {}
    if not isinstance(cache, dict):
        cache = {}
    state["available"] = cache.get("remote") not in (None, local)
    checked = cache.get("checked")
    if isinstance(checked, (int, float)) and time.time() - checked < 86400:
        return

    def check():
        latest = fetch_latest()
        if latest is not None:
            remote = hashlib.sha256(latest).hexdigest()
            remember(remote)
            state["available"] = remote != local

    threading.Thread(target=check, daemon=True).start()


def update_self():
    if from_git():
        print(f"clm runs from a git clone at {shorten(HERE.parent)}, updating with git pull.", flush=True)
        return subprocess.run(["git", "-C", str(HERE.parent), "pull", "--ff-only"], check=False).returncode
    latest = fetch_latest()
    if latest is None:
        print("Could not download the latest clm.", file=sys.stderr)
        return 1
    remember(hashlib.sha256(latest).hexdigest())
    if latest == HERE.read_bytes():
        print("clm is already up to date.")
        return 0
    staged = HERE.with_name(HERE.name + ".new")
    try:
        staged.write_bytes(latest)
        staged.chmod(0o755)
        os.replace(staged, HERE)
    except OSError as exc:
        staged.unlink(missing_ok=True)
        print(f"Could not update {HERE}: {exc}", file=sys.stderr)
        return 1
    print(f"Updated {shorten(HERE)}.")
    return 0


def browse(screen, projects, root, folder, error, updates):
    curses.set_escdelay(25)
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    C = {"text": 0, "title": curses.A_BOLD, "dim": curses.A_DIM, "accent": curses.A_BOLD,
         "sel": curses.A_REVERSE, "border": curses.A_DIM, "new": 0, "old": 0,
         "err": curses.A_BOLD, "bar": curses.A_REVERSE, "key": curses.A_REVERSE | curses.A_BOLD}
    if curses.has_colors() and curses.COLORS >= 256:
        palette = {"text": (252, 236), "title": (255, 236), "dim": (244, 236), "accent": (141, 236),
                   "sel": (255, 54), "border": (240, 236), "new": (114, 236), "old": (179, 236),
                   "err": (210, 236), "bar": (250, 238), "key": (141, 238)}
        for number, (name, (fg, bg)) in enumerate(palette.items(), 1):
            curses.init_pair(number, fg, bg)
            C[name] = curses.color_pair(number)
        for name in ("title", "accent", "err", "key"):
            C[name] |= curses.A_BOLD

    selected = offset = 0
    query, focus = "", None
    chats_by_folder = dict(projects)
    parent_of = {
        project: next((parent for parent in project.parents
                       if parent in chats_by_folder), None)
        for project in chats_by_folder
    }
    children = {}
    for project, parent in parent_of.items():
        children.setdefault(parent, []).append(project)
    totals = {project: [0, None] for project in chats_by_folder}
    for project, chats in chats_by_folder.items():
        step = project
        while chats and step is not None:
            totals[step][0] += len(chats)
            totals[step][1] = max(totals[step][1] or 0, chats[0].modified)
            step = parent_of[step]
    for kids in children.values():
        kids.sort(key=lambda p: (-(totals[p][1] or 0), p.name.casefold()))

    def put(y, x, text, attr=None, limit=None):
        height, width = screen.getmaxyx()
        room = width - x if limit is None else min(width - x, limit)
        if not (0 <= y < height and x >= 0 and room > 0):
            return x
        text = clipped(text, room)
        try:
            screen.addnstr(y, x, text, room, C["text"] if attr is None else attr)
        except curses.error:
            pass
        return x + len(text)

    def segments(y, x, parts, limit):
        end = x + limit
        for text, attr in parts:
            if x >= end:
                break
            x = put(y, x, text, attr, end - x)
        return x

    def box(top, left, bottom, width, title=""):
        put(top, left, "╭" + "─" * (width - 2) + "╮", C["border"])
        for y in range(top + 1, bottom):
            put(y, left, "│", C["border"])
            put(y, left + width - 1, "│", C["border"])
        put(bottom, left, "╰" + "─" * (width - 2) + "╯", C["border"])
        if title:
            put(top, left + 2, f" {title} ", C["accent"])

    def count(n, word):
        return f"{n} {word}{'s' * (n != 1)}"

    def land(index, direction):
        index = max(0, min(len(rows) - 1, index))
        if rows and rows[index][0] == "label":
            index = index + direction if 0 <= index + direction < len(rows) else index - direction
        return index

    def draw_row(y, x, width, row, active):
        kind, item, title, _ = row
        look = (lambda name: C["sel"]) if active else (lambda name: C[name])
        if kind == "new":
            put(y, x, "+  New chat", look("accent"))
            return
        if kind == "label":
            end = put(y, x, title + " ", C["dim"])
            put(y, end, "─" * (x + width - end), C["border"])
            return
        if kind == "folder":
            total, stamp = totals[item]
            right = count(total, "chat") + (f"  {ago(stamp):>3}" if stamp else "     ")
            room = width - len(right) - 4
            label, tone = clipped(plain(title), room - 1) + "/", "text" if total else "dim"
        else:
            stamp, right = item.modified, ago(item.modified)
            room = width - len(right) - 4
            label, tone = clipped(plain(title), room), "text"
        put(y, x, "●" if stamp else "○", look(heat(stamp)))
        put(y, x + 2, label, look(tone))
        put(y, x + width - len(right), right, look("dim"))

    def details(row, width, room):
        kind, item = row[:2]
        blank = []

        def wrap(text, attr, most=None):
            lines = textwrap.wrap(text, width)
            if most is not None and len(lines) > most:
                lines = lines[:most]
                lines[-1] = clipped(lines[-1] + " …", width)
            return [[(line, attr)] for line in lines]

        if kind == "new":
            return [[("New chat", C["title"])], [(shorten(folder), C["dim"])], blank,
                    *wrap("Start a fresh Claude Code session in this folder.", C["text"])], "start a new chat"
        if kind == "chat":
            named = item.title != item.preview
            when = datetime.fromtimestamp(item.modified).strftime("%a %b %d, %H:%M")
            lines = [*wrap(item.title, C["title"], 3 if named else max(3, room - 3)),
                     [(ago(item.modified, True), C["text"]), ("  ·  " + when, C["dim"])],
                     [("session  " + item.session_id, C["dim"])]]
            if named and item.preview:
                lines += [blank, [("First message", C["accent"])],
                          *wrap(item.preview, C["text"], max(1, room - len(lines) - 2))]
            return lines, "resume this chat"
        chats, subs = chats_by_folder[item], children.get(item, [])
        nested = totals[item][0] - len(chats)
        facts = [("Chats", str(len(chats)) + (f" here, {nested} in subfolders" if nested else ""))]
        if totals[item][1]:
            facts.append(("Last active", ago(totals[item][1], True)))
        if git_branch(item):
            facts.append(("Branch", git_branch(item)))
        if subs:
            facts.append(("Folders", ", ".join(sub.name for sub in subs)))
        lines = [[(item.name, C["title"])], [(shorten(item), C["dim"])], blank,
                 *[[(f"{name:<13}", C["dim"]), (value, C["text"])] for name, value in facts], blank]
        if not chats:
            return lines + [[("Chats are in subfolders." if nested else "No chats yet.", C["dim"])]], "open"
        lines.append([("Recent chats", C["accent"])])
        for chat in chats:
            right = ago(chat.modified)
            room = width - len(right) - 3
            lines.append([("● ", C[heat(chat.modified)]),
                          (clipped(plain(chat.title), room).ljust(room + 1), C["text"]), (right, C["dim"])])
        return lines, "open"

    while True:
        screen.erase()
        height, width = screen.getmaxyx()
        if C["text"]:
            for y in range(height):
                screen.hline(y, 0, " ", width - (y == height - 1), C["text"])
        below = [p for p in chats_by_folder if folder in p.parents]
        needle = query.casefold()
        keep = lambda group: [row for row in group if needle in (row[2] + " " + row[3]).casefold()]
        rows = keep([("new", None, "New chat", "")])
        own = keep([("chat", c, c.title, c.preview) for c in chats_by_folder[folder]])
        subs = keep([("folder", p, str(p.relative_to(folder)), shorten(p))
                     for p in (below if query else children.get(folder, []))])
        both = bool(own and subs)
        rows += [("label", None, f"Chats in {folder.name or '/'}", "")] * both + own
        rows += [("label", None, "Folders", "")] * both + subs
        items = sum(row[0] != "label" for row in rows)
        if focus is not None:
            selected = next((i for i, row in enumerate(rows) if row[1] == focus), 0)
            focus = None
        selected = land(selected, 1)

        margin = 2 if width >= 60 else 0
        inner = width - 2 * margin
        trail, step = [], folder
        while step is not None:
            trail.append(step.name)
            step = parent_of.get(step)
        crumbs = []
        for index, name in enumerate(reversed(trail)):
            crumbs += [("  ›  ", C["accent"])] * bool(index)
            crumbs.append((name or "/", C["title"] if index == len(trail) - 1 else C["dim"]))
        stats = f"{count(len(children.get(folder, [])), 'folder')}  ·  {count(totals[folder][0], 'chat')}"
        if height >= 22 and width >= 64:
            top = 1 if height >= 26 else 0
            for y, (c, l, m) in enumerate(WORDMARK, top):
                put(y, margin + 1, f"{c:<12}{l:<11}{m}", C["accent"])
            info = margin + 38
            segments(top + 1, info, crumbs, width - info - margin)
            put(top + 2, info, shorten(folder), C["dim"])
            put(top + 3, info, stats, C["dim"])
            search = top + 6
        else:
            x = put(0, margin, "◈ clm   ", C["accent"])
            segments(0, x, crumbs + [("   " + stats, C["dim"])], width - x - margin)
            search = 1

        box(search, margin, search + 2, inner)
        x = put(search + 1, margin + 2, "› ", C["accent"])
        if query:
            found = count(len(rows), "match").replace("matchs", "matches")
            x = put(search + 1, x, query, C["title"], inner - len(found) - 8)
            put(search + 1, x, "▏", C["accent"])
            put(search + 1, margin + inner - 2 - len(found), found, C["dim"])
        else:
            put(search + 1, x, "Type to search folders and chats",
                C["dim"], inner - 6)

        top, bottom = search + 3, max(search + 5, height - 3)
        split = inner >= 96
        list_width = max(44, inner * 9 // 20) if split else inner
        visible = bottom - top - 1
        offset = min(offset, selected, max(0, len(rows) - visible))
        offset = max(offset, selected - visible + 1)
        box(top, margin, bottom, list_width, "Projects" if folder == root else "Chats")
        for index, row in enumerate(rows[offset:offset + visible], offset):
            y = top + 1 + index - offset
            if index == selected:
                put(y, margin + 1, " " * (list_width - 2), C["sel"])
            draw_row(y, margin + 2, list_width - 4, row, index == selected)
        if not rows:
            put(top + 1, margin + 2, "No matches" if query else "No folders or chats here yet",
                C["dim"], list_width - 4)
        if len(rows) > visible:
            thumb = max(1, visible * visible // len(rows))
            start = offset * (visible - thumb) // (len(rows) - visible)
            for y in range(top + 1 + start, top + 1 + start + thumb):
                put(y, margin + list_width - 1, "┃", C["accent"])
        if split:
            left, panel = margin + list_width + 1, inner - list_width - 1
            box(top, left, bottom, panel, "Details")
            if rows:
                lines, action = details(rows[selected], panel - 4, visible - 2)
                for y, parts in enumerate(lines[:max(0, visible - 2)], top + 1):
                    segments(y, left + 2, parts, panel - 4)
                segments(bottom - 1, left + 2, [("⏎ ", C["accent"]), ("Enter", C["text"]),
                                                (" to " + action, C["dim"])], panel - 4)

        if error:
            put(height - 2, margin + 1, error, C["err"])
        elif rows and not split and rows[selected][3] != rows[selected][2]:
            put(height - 2, margin + 1, plain(rows[selected][3]), C["dim"], inner - 2)
        try:
            screen.hline(height - 1, 0, " ", width, C["bar"])
        except curses.error:
            pass
        escape = "clear" if query else "back" if folder != root else "quit"
        x = margin + 1
        hints = [("↑↓", "move"), ("⏎", "open"), ("esc", escape)] + [("^C", "quit")] * (escape != "quit")
        for key_name, label in hints:
            x = put(height - 1, x, f" {key_name} ", C["key"])
            x = put(height - 1, x, f" {label}   ", C["bar"])
        right = width - margin - 1
        if rows:
            position = f"{sum(row[0] != 'label' for row in rows[:selected + 1])} / {items}"
            right -= len(position)
            put(height - 1, right, position, C["bar"])
        if updates["available"]:
            notice = " update available · clm --update "
            if right - len(notice) - 3 > x:
                put(height - 1, right - len(notice) - 3, notice, C["key"])
        screen.refresh()

        key = screen.get_wch()
        error = ""
        if key == curses.KEY_UP:
            selected = land(selected - 1, -1)
        elif key == curses.KEY_DOWN:
            selected = land(selected + 1, 1)
        elif key == curses.KEY_PPAGE:
            selected = land(selected - visible, -1)
        elif key == curses.KEY_NPAGE:
            selected = land(selected + visible, 1)
        elif key in ("\n", "\r", curses.KEY_ENTER):
            if not rows:
                continue
            kind, choice = rows[selected][:2]
            if kind in ("new", "chat"):
                return folder, choice
            folder = choice
            selected, offset, query = 0, 0, ""
        elif key == "\x1b":
            if query:
                selected, offset, query = 0, 0, ""
            elif folder != root:
                focus, folder = folder, parent_of.get(folder)
                offset = 0
            else:
                return None
        elif key == "/" and not query:
            continue
        elif key in (curses.KEY_BACKSPACE, "\x7f", "\b"):
            query = query[:-1]
            selected = 0
        elif isinstance(key, str) and key.isprintable():
            query += key
            selected = 0


def main():
    if sys.argv[1:] in (["--help"], ["-h"]):
        print("clm — browse local Claude Code projects and chats\n"
              "Type to search · ↑↓ move · Enter open · Esc clear / back · Ctrl-C quit\n"
              "clm --update   install the latest version")
        return 0
    if sys.argv[1:] == ["--update"]:
        return update_self()
    if sys.argv[1:]:
        print("Usage: clm [--update]", file=sys.stderr)
        return 2
    claude = shutil.which("claude")
    if claude is None or not (sys.stdin.isatty() and sys.stdout.isatty()):
        print("Run clm in a terminal with Claude Code on your PATH.", file=sys.stderr)
        return 1

    try:
        root = Path.cwd().resolve()
    except OSError:
        root = Path.home()
    folder, error = root, ""
    updates = {"available": False}
    watch_for_update(updates)
    try:
        while True:
            choice = curses.wrapper(browse, catalog(root), root, folder, error, updates)
            if choice is None:
                return 0
            folder, chat = choice
            command = [claude, "--resume", chat.session_id] if chat else [claude]
            try:
                result = subprocess.run(command, cwd=folder, check=False)
                error = f"Claude Code exited with status {result.returncode}." if result.returncode else ""
            except KeyboardInterrupt:
                error = ""
            except OSError as exc:
                error = plain(str(exc))
    except KeyboardInterrupt:
        return 130
    except (curses.error, OSError) as exc:
        print(f"Could not open clm: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
